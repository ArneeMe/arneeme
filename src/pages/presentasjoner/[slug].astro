---
// Visningsside for én presentasjon. Den opplastede HTML-filen vises i en
// iframe som dekker hele vinduet. Ingen sandbox: filene ligger i repoet og
// er like betrodd som resten av siden, og presentasjonene trenger full JS,
// localStorage og Fullscreen API. Hvis plattformen senere skal ta imot filer
// fra andre, bør de serveres fra et eget origin i stedet.
import { presentasjoner, kildeUrl, type Presentasjon } from '../../presentasjoner/registry';

export function getStaticPaths() {
  return presentasjoner.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Presentasjon };
const src = kildeUrl(p);
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{p.tittel} · arnee.me</title>
    <link rel="icon" type="image/svg+xml" href="/icons/presentasjon.svg" />
    <meta name="description" content={p.beskrivelse} />
    <meta property="og:title" content={p.tittel} />
    <meta property="og:description" content={p.beskrivelse} />
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: #000;
      }
      #pres-frame {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
        background: #fff;
      }
      .pres-bar {
        position: fixed;
        top: 8px;
        left: 8px;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 3px;
        font: 11px 'Pixelated MS Sans Serif', Arial, sans-serif;
        background: #c0c0c0;
        border: 2px solid;
        border-color: #fff #808080 #808080 #fff;
        box-shadow: 1px 1px 0 #000;
        transition: opacity 0.25s;
      }
      .pres-bar.skjult {
        opacity: 0;
        pointer-events: none;
      }
      .pres-bar a,
      .pres-bar button {
        font: inherit;
        color: #000;
        text-decoration: none;
        padding: 2px 8px;
        background: #c0c0c0;
        border: 2px solid;
        border-color: #fff #808080 #808080 #fff;
        cursor: pointer;
      }
      .pres-bar a:active,
      .pres-bar button:active {
        border-color: #808080 #fff #fff #808080;
      }
      .pres-bar-tittel {
        padding: 0 6px;
        font-weight: bold;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 40vw;
      }
    </style>
  </head>
  <body>
    <iframe
      id="pres-frame"
      src={src}
      title={p.tittel}
      allow="fullscreen; autoplay; clipboard-write"
      allowfullscreen
    ></iframe>

    <nav class="pres-bar" id="pres-bar" aria-label="Presentasjon">
      <a href="/presentasjoner/">← Alle</a>
      <span class="pres-bar-tittel">{p.tittel}</span>
      <button type="button" id="pres-fullskjerm">Fullskjerm</button>
      <a href={src} target="_blank" rel="noopener">Åpne fil</a>
    </nav>

    <script>
      const frame = document.getElementById('pres-frame') as HTMLIFrameElement;
      const bar = document.getElementById('pres-bar') as HTMLElement;
      const fsBtn = document.getElementById('pres-fullskjerm') as HTMLButtonElement;

      // ── Fokus: tastetrykk skal gå til presentasjonen uten klikk ──────────
      const fokuser = () => {
        frame.focus();
        frame.contentWindow?.focus();
      };

      // Fanger tastetrykk som havner i forelderen (f.eks. etter klikk på
      // verktøylinja) og sender dem videre inn i presentasjonen.
      const VIDERESEND = new Set([
        'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown',
        'PageUp', 'PageDown', 'Home', 'End', ' ', 'Enter', 'Escape',
      ]);
      window.addEventListener('keydown', (e) => {
        const win = frame.contentWindow;
        const doc = frame.contentDocument;
        if (!win || !doc) return;
        // Enter/mellomrom på en knapp i verktøylinja skal virke som vanlig.
        if ((e.key === 'Enter' || e.key === ' ') && bar.contains(e.target as Node)) return;
        if (!VIDERESEND.has(e.key) && e.key.length !== 1) return;
        const target = doc.activeElement ?? doc.body ?? doc.documentElement;
        const kopi = new win.KeyboardEvent('keydown', {
          key: e.key,
          code: e.code,
          shiftKey: e.shiftKey,
          altKey: e.altKey,
          ctrlKey: e.ctrlKey,
          metaKey: e.metaKey,
          repeat: e.repeat,
          bubbles: true,
          cancelable: true,
        });
        target.dispatchEvent(kopi);
        e.preventDefault();
        fokuser();
      });

      // ── Verktøylinje som skjuler seg selv ────────────────────────────────
      let skjulTimer: ReturnType<typeof setTimeout> | undefined;
      const visBar = () => {
        bar.classList.remove('skjult');
        clearTimeout(skjulTimer);
        skjulTimer = setTimeout(() => {
          if (!bar.matches(':hover')) bar.classList.add('skjult');
        }, 2500);
      };
      window.addEventListener('mousemove', visBar);
      bar.addEventListener('mouseleave', visBar);

      frame.addEventListener('load', () => {
        fokuser();
        visBar();
        // Musebevegelser inne i iframen når ikke forelderen; samme origin
        // lar oss lytte direkte.
        try {
          frame.contentWindow?.addEventListener('mousemove', visBar);
          const tittel = frame.contentDocument?.title;
          if (tittel) document.title = `${tittel} · arnee.me`;
        } catch {}
      });
      fokuser();
      visBar();

      // ── Fullskjerm ───────────────────────────────────────────────────────
      const oppdaterFsKnapp = () => {
        fsBtn.textContent = document.fullscreenElement ? 'Avslutt fullskjerm' : 'Fullskjerm';
      };
      fsBtn.addEventListener('click', async () => {
        try {
          if (document.fullscreenElement) await document.exitFullscreen();
          else await document.documentElement.requestFullscreen();
        } catch {}
        fokuser();
      });
      document.addEventListener('fullscreenchange', () => {
        oppdaterFsKnapp();
        fokuser();
      });
      if (!document.fullscreenEnabled) fsBtn.hidden = true;
    </script>
  </body>
</html>
